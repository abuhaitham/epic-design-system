{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/brand/**",
              "components/cards/**",
              "components/display/**",
              "components/forms/**",
              "components/navigation/**",
              "components/sections/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:GC Gatuzo|IBM Plex Sans Arabic))/i]",
        "message": "Font not provided by the design system. Available: GC Gatuzo, IBM Plex Sans Arabic."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|upper|dot|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, upper, dot, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:neutral|blue|solid|dark|outline|success)$/]",
        "message": "<Badge> variant must be one of 'neutral' | 'blue' | 'solid' | 'dark' | 'outline' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|arrow|iconStart|iconEnd|block|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, arrow, iconStart, iconEnd, block, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|dark|outline|light|link)$/]",
        "message": "<Button> variant must be one of 'primary' | 'dark' | 'outline' | 'light' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|type|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, type."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:checkbox|radio)$/]",
        "message": "<Checkbox> type must be one of 'checkbox' | 'radio'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTABand'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|text|primaryCta|secondaryCta|variant|flush|className|children|key|ref|className|style|children)$/]",
        "message": "<CTABand> doesn't accept that prop. Declared props: eyebrow, title, text, primaryCta, secondaryCta, variant, flush, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTABand'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:glow-dark|glow|glow-stone|blue|black|fluted)$/]",
        "message": "<CTABand> variant must be one of 'glow-dark' | 'glow' | 'glow-stone' | 'blue' | 'black' | 'fluted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FAQItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:q|a|key|ref|className|style|children)$/]",
        "message": "<FAQItem> doesn't accept that prop. Declared props: q, a."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:heading|links|key|ref|className|style|children)$/]",
        "message": "<FooterColumn> doesn't accept that prop. Declared props: heading, links."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlowSurface'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|grain|as|children|key|ref|className|style|children)$/]",
        "message": "<GlowSurface> doesn't accept that prop. Declared props: variant, grain, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CtaSpec'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|onClick|variant|arrow|key|ref|className|style|children)$/]",
        "message": "<CtaSpec> doesn't accept that prop. Declared props: label, href, onClick, variant, arrow."
      },
      {
        "selector": "JSXOpeningElement[name.name='CtaSpec'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|dark|outline|light|link)$/]",
        "message": "<CtaSpec> variant must be one of 'primary' | 'dark' | 'outline' | 'light' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|flip|title|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, flip, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|dark|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, error, dark."
      },
      {
        "selector": "JSXOpeningElement[name.name='InsightCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|category|date|readTime|excerpt|image|mediaVariant|href|className|key|ref|className|style|children)$/]",
        "message": "<InsightCard> doesn't accept that prop. Declared props: title, category, date, readTime, excerpt, image, mediaVariant, href, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|markColor|wordmark|size|href|className|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: color, markColor, wordmark, size, href, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|logos|duration|className|key|ref|className|style|children)$/]",
        "message": "<LogoStrip> doesn't accept that prop. Declared props: label, logos, duration, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Step'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|text|key|ref|className|style|children)$/]",
        "message": "<Step> doesn't accept that prop. Declared props: title, text."
      },
      {
        "selector": "JSXOpeningElement[name.name='PackageCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:badge|title|description|includes|price|priceUnit|primaryCta|secondaryCta|image|mediaVariant|variant|className|key|ref|className|style|children)$/]",
        "message": "<PackageCard> doesn't accept that prop. Declared props: badge, title, description, includes, price, priceUnit, primaryCta, secondaryCta, image, mediaVariant, variant, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='PackageCard'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:black|blue)$/]",
        "message": "<PackageCard> variant must be one of 'black' | 'blue'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillarCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|title|tagline|tags|href|onClick|variant|className|key|ref|className|style|children)$/]",
        "message": "<PillarCard> doesn't accept that prop. Declared props: index, title, tagline, tags, href, onClick, variant, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillarCard'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:white|stone|blue|black)$/]",
        "message": "<PillarCard> variant must be one of 'white' | 'stone' | 'blue' | 'black'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProfileCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|handle|bio|avatar|verified|stats|ctaLabel|onCta|bannerVariant|className|key|ref|className|style|children)$/]",
        "message": "<ProfileCard> doesn't accept that prop. Declared props: name, handle, bio, avatar, verified, stats, ctaLabel, onCta, bannerVariant, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Reveal'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|delay|variant|once|threshold|children|key|ref|className|style|children)$/]",
        "message": "<Reveal> doesn't accept that prop. Declared props: as, delay, variant, once, threshold, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Reveal'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:up|fade|scale)$/]",
        "message": "<Reveal> variant must be one of 'up' | 'fade' | 'scale'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|lead|action|className|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: eyebrow, title, lead, action, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|options|placeholder|dark|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, hint, error, options, placeholder, dark."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|eyebrow|title|tagline|items|cta|image|imageAlt|media|mediaVariant|reverse|id|className|key|ref|className|style|children)$/]",
        "message": "<ServiceRow> doesn't accept that prop. Declared props: index, eyebrow, title, tagline, items, cta, image, imageAlt, media, mediaVariant, reverse, id, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<NavLink> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|suffix|label|key|ref|className|style|children)$/]",
        "message": "<Stat> doesn't accept that prop. Declared props: value, suffix, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: id, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='TeamCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|role|photo|linkedin|className|key|ref|className|style|children)$/]",
        "message": "<TeamCard> doesn't accept that prop. Declared props: name, role, photo, linkedin, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='TestimonialCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|name|role|avatar|variant|className|key|ref|className|style|children)$/]",
        "message": "<TestimonialCard> doesn't accept that prop. Declared props: quote, name, role, avatar, variant, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='TestimonialCard'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:white|dark)$/]",
        "message": "<TestimonialCard> variant must be one of 'white' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Textarea'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|dark|key|ref|className|style|children)$/]",
        "message": "<Textarea> doesn't accept that prop. Declared props: label, hint, error, dark."
      },
      {
        "selector": "JSXOpeningElement[name.name='WhatsAppButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:phone|message|label|float|iconOnly|key|ref|className|style|children)$/]",
        "message": "<WhatsAppButton> doesn't accept that prop. Declared props: phone, message, label, float, iconOnly."
      }
    ]
  },
